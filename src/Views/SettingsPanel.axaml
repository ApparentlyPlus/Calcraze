<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Calcraze.ViewModels"
             x:Class="Calcraze.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LetterSpacing" Value="4"/>
            <Setter Property="Foreground" Value="#D0D0DE"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#A2A2B4"/>
        </Style>
        <Style Selector="TextBox.setting">
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="BorderBrush" Value="#2A2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8E8E2"/>
            <Setter Property="CaretBrush" Value="#EFA94A"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ComboBox.setting">
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="BorderBrush" Value="#2A2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8E8E2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="CheckBox.setting">
            <Setter Property="Foreground" Value="#E2E2EE"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#111118" CornerRadius="10" Padding="26" MaxWidth="760" HorizontalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="ROUND"/>
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="12">
                        <TextBlock Text="Duration (seconds)" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Classes="setting" Width="140" VerticalAlignment="Center"
                                 Text="{Binding RoundDurationSeconds}"/>
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Total time for a round. Shorter rounds increase the pace and raise the speed bonus threshold."/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="STARTING PRESET"/>
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="12">
                        <TextBlock Text="Preset" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Classes="setting"
                                  Width="160"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding PresetOptions}"
                                  SelectedItem="{Binding SelectedPresetName}"/>
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Easy, Balanced, and Hard are built-in presets. Choose Custom to define your own ExpressionConfig."/>
                </StackPanel>

                <StackPanel Spacing="10" IsVisible="{Binding IsCustomPreset}">
                    <TextBlock Classes="section-title" Text="CUSTOM EXPRESSIONCONFIG"/>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="These fields directly map to ExpressionConfig. They control how the generator builds and weighs expressions."/>

                    <WrapPanel>
                        <StackPanel MinWidth="180" MaxWidth="240" Spacing="6" Margin="0,0,12,12">
                            <TextBlock Text="MaxDepth"/>
                            <TextBox Classes="setting" Text="{Binding CustomMaxDepth}"/>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="How many nested layers the expression tree can have."/>
                        </StackPanel>
                        <StackPanel MinWidth="180" MaxWidth="240" Spacing="6" Margin="0,0,12,12">
                            <TextBlock Text="LeafBias"/>
                            <TextBox Classes="setting" Text="{Binding CustomLeafBias}"/>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="Chance to stop early and emit a leaf. Lower = deeper trees."/>
                        </StackPanel>
                        <StackPanel MinWidth="180" MaxWidth="240" Spacing="6" Margin="0,0,12,12">
                            <TextBlock Text="AllowNegative"/>
                            <CheckBox Classes="setting" IsChecked="{Binding CustomAllowNegative}" Content="Enable"/>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="Allows negative values in leaves and intermediate results."/>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel>
                        <StackPanel MinWidth="180" MaxWidth="240" Spacing="6" Margin="0,0,12,12">
                            <TextBlock Text="TargetMin"/>
                            <TextBox Classes="setting" Text="{Binding CustomTargetMin}"/>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="Lower bound for the final answer."/>
                        </StackPanel>
                        <StackPanel MinWidth="180" MaxWidth="240" Spacing="6" Margin="0,0,12,12">
                            <TextBlock Text="TargetMax"/>
                            <TextBox Classes="setting" Text="{Binding CustomTargetMax}"/>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="Upper bound for the final answer."/>
                        </StackPanel>
                        <StackPanel MinWidth="180" MaxWidth="240" Spacing="6" Margin="0,0,12,12">
                            <TextBlock Text="LeafMin / LeafMax"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Classes="setting" Width="92" Text="{Binding CustomLeafMin}"/>
                                <TextBox Classes="setting" Width="92" Text="{Binding CustomLeafMax}"/>
                            </StackPanel>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="Range for raw leaf numbers used by the generator."/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Operator Weights"/>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Add"/>
                            <TextBox Grid.Row="1" Grid.Column="0" Classes="setting" Width="90" Text="{Binding CustomAddWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Subtract"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Classes="setting" Width="90" Text="{Binding CustomSubtractWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Multiply"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Classes="setting" Width="90" Text="{Binding CustomMultiplyWeight}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Divide"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Classes="setting" Width="90" Text="{Binding CustomDivideWeight}"/>
                        </Grid>
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Higher numbers make an operator more likely when building expressions."/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
